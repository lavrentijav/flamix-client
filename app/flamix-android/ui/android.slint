// Phone layout of Flamix (M4). The window is shown by the Android entry point (src/lib.rs).
// Dark colours are copied from app/flamix/ui/theme.slint (keep in sync).
import { LineEdit, ScrollView, Switch, TextEdit } from "std-widgets.slint";

global Theme {
    out property <color> window-bg: #2B2621;
    out property <color> panel-bg: #3D3328;
    out property <color> card-header: #5A4632;
    out property <color> card-body: #4A3B2C;
    out property <color> accent: #C07A2C;
    out property <color> text: #F2E9DF;
    out property <color> muted: #B9A894;
    out property <color> success: #6CCB5F;
    out property <color> warning: #E3B341;
    out property <color> danger: #E5534B;
    out property <color> info: #5AA7FF;
    out property <color> on-accent: #FFFFFF;
    out property <color> stroke: #FFFFFF14;
    out property <color> hover: #FFFFFF12;
    out property <color> track: #FFFFFF1A;
    out property <length> radius: 10px;
}

/// One server row of the servers tab (see phone.rs `ServerRow`).
export struct PhoneServer {
    id: string,
    name: string,
    subtitle: string,
    address: string,
    /// true = measured exit IP, false = entry address (shown with a "вход" label)
    is-exit: bool,
    /// servers sharing this exit IP (0 = unique/unknown)
    group: int,
    selected: bool,
    /// -2 untested, -1 failed, otherwise ms
    ping: int,
    has-quota: bool,
    quota-fraction: float,
    quota-text: string,
}

/// One custom routing rule (routing tab). `kind`: 0 domains, 1 IPs, 2 processes (first shown).
export struct PhoneRule {
    index: int,
    /// 0 proxy, 1 direct, 2 block
    action: int,
    enabled: bool,
    kind: int,
    domains: string,
    ips: string,
    processes: string,
}

/// One header card of the statistics tab.
export struct PhoneStatCard {
    title: string,
    value: string,
    up: string,
    down: string,
}

/// One day column of the statistics chart (bar heights 0..1 of the busiest day).
export struct PhoneDay {
    label: string,
    up: float,
    down: float,
}

/// One busiest-server line of the statistics tab.
export struct PhoneTop {
    name: string,
    iso: string,
    used: string,
    fraction: float,
}

/// One subscription row of the provider-routing section.
export struct PhoneProvider {
    id: string,
    name: string,
    rules-text: string,
    enabled: bool,
    ignored: bool,
}

/// One subscription card of the servers tab (see phone.rs `SubCard`).
export struct PhoneSub {
    id: string,
    name: string,
    local: bool,
    collapsed: bool,
    pinned: bool,
    updating: bool,
    has-traffic: bool,
    traffic-text: string,
    traffic-fraction: float,
    expire-text: string,
    banner-text: string,
    /// 0 info, 1 red, 2 green, 3 custom colour, 4 expiry notice
    banner-tone: int,
    banner-color: color,
    banner-button: string,
    banner-link: string,
    announce: string,
    error: string,
    /// 0 none, 1 Telegram, 2 e-mail, 3 website
    support-kind: int,
    support-url: string,
    web-url: string,
    servers: [PhoneServer],
}

component BottomTab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    horizontal-stretch: 1;
    min-width: lbl.preferred-width + 6px;
    background: transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Image {
                width: 24px;
                height: 24px;
                source: root.icon;
                colorize: root.active ? Theme.accent : Theme.muted;
            }
        }
        lbl := Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.muted;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}

// Square touch target (48 dp) with a centred 22 px icon, recoloured to `tint`.
component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.muted;
    in property <bool> active: false;
    callback clicked();
    width: 48px;
    height: 48px;
    border-radius: 24px;
    background: (ta.has-hover || root.active) ? Theme.hover : transparent;
    Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        source: root.icon;
        colorize: root.tint;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Selectable chip (48 dp high touch target).
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <color> tint: Theme.accent;
    callback clicked();
    height: 48px;
    border-radius: 10px;
    background: root.selected ? root.tint : (ta.has-hover ? Theme.hover : Theme.card-header);
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Full-width action button (48 dp high).
component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();
    height: 48px;
    border-radius: Theme.radius;
    background: root.primary ? (ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent)
        : (ta.has-hover ? Theme.hover : Theme.card-header);
    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.primary ? Theme.on-accent : Theme.text;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// One server row: name, address (exit IP or entry with "вход"), quota bar, ×N, ping colour.
component ServerRowView inherits Rectangle {
    in property <PhoneServer> server;
    callback clicked();
    height: server.has-quota ? 72px : 56px;
    background: server.selected ? Theme.accent.with-alpha(0.18) : transparent;
    property <color> ping-color: server.ping == -1 ? Theme.danger
        : server.ping < 0 ? Theme.muted
        : server.ping < 150 ? Theme.success
        : server.ping < 400 ? Theme.warning
        : Theme.danger;
    property <string> ping-text: server.ping < -1 ? "" : server.ping == -1 ? "—" : "\{server.ping} ms";
    ta := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.server.name;
                color: Theme.text;
                font-size: 15px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.server.address;
                    color: Theme.muted;
                    font-size: 12px;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if !root.server.is-exit : Text {
                    text: "вход";
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if root.server.group > 1 : Text {
                    text: "×\{root.server.group}";
                    color: Theme.accent;
                    font-size: 12px;
                    font-weight: 600;
                }
            }
            Text {
                text: root.server.subtitle;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
            }
            if root.server.has-quota : HorizontalLayout {
                spacing: 8px;
                height: 16px;
                Rectangle {
                    width: 96px;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Theme.track;
                    Rectangle {
                        x: 0;
                        width: min(parent.width * root.server.quota-fraction, parent.width);
                        height: parent.height;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
                Text {
                    text: root.server.quota-text;
                    color: Theme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        Text {
            width: 60px;
            text: root.ping-text;
            color: root.ping-color;
            font-size: 12px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Subscription card: header (tap = collapse), traffic, banner, announce, servers, action row.
component SubCardView inherits Rectangle {
    in property <PhoneSub> sub;
    callback toggle();
    callback pin();
    callback refresh();
    callback settings();
    callback open-url(string);

    callback select-server(string);

    background: Theme.card-body;
    border-radius: Theme.radius;
    clip: true;
    height: content.preferred-height;

    content := VerticalLayout {
        // header
        Rectangle {
            height: 48px;
            background: Theme.card-header;
            TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.toggle(); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: start;
                Image {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../flamix/assets/icons/chevron-down.svg");
                    colorize: Theme.text;
                    transform-rotation: root.sub.collapsed ? -90deg : 0deg;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.sub.name;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }

        if root.sub.has-traffic : VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 6px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: root.sub.traffic-text;
                    color: Theme.text;
                    font-size: 13px;
                    overflow: elide;
                }
                if root.sub.expire-text != "" : Text {
                    text: root.sub.expire-text;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: right;
                }
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: min(parent.width * root.sub.traffic-fraction, parent.width);
                    height: parent.height;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
        }

        // Provider banner (expiry notice replaces the info banner, see phone.rs).
        if root.sub.banner-text != "" : Rectangle {
            property <color> tint: root.sub.banner-tone == 1 ? Theme.danger
                : root.sub.banner-tone == 2 ? Theme.success
                : root.sub.banner-tone == 3 ? root.sub.banner-color
                : root.sub.banner-tone == 4 ? Theme.warning
                : Theme.info;
            height: banner-col.preferred-height;
            background: tint.with-alpha(0.16);
            border-radius: 8px;
            clip: true;
            banner-col := VerticalLayout {
                padding-top: 6px;
                padding-bottom: 6px;
                padding-right: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Rectangle { width: 3px; background: tint; }
                    Text {
                        horizontal-stretch: 1;
                        text: root.sub.banner-text;
                        color: Theme.text;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    if root.sub.banner-button != "" : Rectangle {
                        width: btn-label.preferred-width + 24px;
                        height: 36px;
                        border-radius: 8px;
                        background: tint;
                        btn-label := Text {
                            text: root.sub.banner-button;
                            color: #2B2621;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                        TouchArea { clicked => { root.open-url(root.sub.banner-link); } }
                    }
                }
            }
        }

        if root.sub.announce != "" : HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                Text {
                text: root.sub.announce;
                color: Theme.muted;
                font-size: 12px;
                wrap: word-wrap;
            }
            }
        if root.sub.error != "" : HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        padding-top: 6px;
                Text {
                text: root.sub.error;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
            }

        if !root.sub.collapsed : VerticalLayout {
            padding-top: 4px;
            padding-bottom: 2px;
            for s in root.sub.servers : ServerRowView {
                server: s;
                clicked => { root.select-server(s.id); }
            }
            if root.sub.servers.length == 0 : HorizontalLayout {
                                padding-left: 14px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                    Text {
                    text: "Серверов нет";
                    color: Theme.muted;
                    font-size: 13px;
                }
                }
        }

        // Action row: support and site on the left, pin / refresh / settings on the right.
        if !root.sub.local : HorizontalLayout {
            height: 48px;
            padding-left: 4px;
            padding-right: 4px;
            spacing: 2px;
            if root.sub.support-kind != 0 : IconBtn {
                icon: root.sub.support-kind == 1 ? @image-url("../../flamix/assets/icons/telegram.svg")
                    : root.sub.support-kind == 2 ? @image-url("../../flamix/assets/icons/mail.svg")
                    : @image-url("../../flamix/assets/icons/support.svg");
                tint: Theme.accent;
                clicked => { root.open-url(root.sub.support-url); }
            }
            if root.sub.web-url != "" : IconBtn {
                icon: @image-url("../../flamix/assets/icons/globe.svg");
                tint: Theme.accent;
                clicked => { root.open-url(root.sub.web-url); }
            }
            Rectangle { horizontal-stretch: 1; }
            IconBtn {
                icon: @image-url("../../flamix/assets/icons/pin.svg");
                tint: root.sub.pinned ? Theme.accent : Theme.muted;
                clicked => { root.pin(); }
            }
            IconBtn {
                icon: @image-url("../../flamix/assets/icons/refresh.svg");
                tint: root.sub.updating ? Theme.accent : Theme.muted;
                clicked => { root.refresh(); }
            }
            IconBtn {
                icon: @image-url("../../flamix/assets/icons/settings.svg");
                clicked => { root.settings(); }
            }
        }
    }
}

// One custom rule: action chips, enable switch, delete, value kind and the value text.
component RuleView inherits Rectangle {
    in property <PhoneRule> rule;
    in-out property <int> current-kind: rule.kind;
    callback action-changed(int);
    callback enabled-changed(bool);
    callback delete-rule();
    callback values-edited(int, string);
    background: Theme.card-header;
    border-radius: Theme.radius;
    height: rule-col.preferred-height + 24px;
    rule-col := VerticalLayout {
        x: 10px;
        y: 12px;
        width: parent.width - 20px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 6px;
            Chip { horizontal-stretch: 1; text: "Прокси"; selected: root.rule.action == 0; clicked => { root.action-changed(0); } }
            Chip { horizontal-stretch: 1; text: "Напрямую"; selected: root.rule.action == 1; tint: Theme.success; clicked => { root.action-changed(1); } }
            Chip { horizontal-stretch: 1; text: "Блок"; selected: root.rule.action == 2; tint: Theme.danger; clicked => { root.action-changed(2); } }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Chip { horizontal-stretch: 1; text: "Домены"; selected: root.current-kind == 0; clicked => { root.current-kind = 0; } }
            Chip { horizontal-stretch: 1; text: "IP / подсети"; selected: root.current-kind == 1; clicked => { root.current-kind = 1; } }
            Chip { horizontal-stretch: 1; text: "Процессы"; selected: root.current-kind == 2; clicked => { root.current-kind = 2; } }
        }
        TextEdit {
            height: 84px;
            font-size: 14px;
            placeholder-text: root.current-kind == 0 ? "geosite:category-ru, domain:example.com"
                : root.current-kind == 1 ? "geoip:ru, 10.0.0.0/8"
                : "telegram.exe, Discord.exe";
            text: root.current-kind == 0 ? root.rule.domains : root.current-kind == 1 ? root.rule.ips : root.rule.processes;
            edited => { root.values-edited(root.current-kind, self.text); }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;
            cross-axis-alignment: center;
            Switch {
                text: root.rule.enabled ? "Включено" : "Выключено";
                checked: root.rule.enabled;
                toggled => { root.enabled-changed(self.checked); }
            }
            Rectangle {
                width: 110px;
                height: 48px;
                border-radius: Theme.radius;
                background: del-ta.has-hover ? Theme.hover : transparent;
                Text { width: parent.width; height: parent.height; text: "Удалить"; color: Theme.danger; font-size: 14px;
                    horizontal-alignment: center; vertical-alignment: center; }
                del-ta := TouchArea { clicked => { root.delete-rule(); } }
            }
        }
    }
}

export component AndroidWindow inherits Window {
    title: "Flamix";
    background: Theme.window-bg;
    preferred-width: 360px;
    preferred-height: 720px;

    in property <[PhoneSub]> subs;
    in property <string> selected-name: "Сервер не выбран";
    in property <string> status-text: "";
    in property <string> connect-label: "Подключить";
    in property <bool> connected: false;
    in property <string> add-status: "";
    in-out property <int> tab: 0;   // 0 Серверы, 1 Добавить, 2 Маршрутизация, 3 Настройки, 4 Статистика

    callback select-server(string);
    callback connect-pressed();
    callback search-changed(string);
    callback sub-toggle(string);
    callback sub-pin(string);
    callback sub-refresh(string);
    callback sub-open-settings(string);
    callback sub-save(string, bool);
    callback sub-delete();
    callback open-url(string);
    // Routing tab
    in property <int> routing-preset: 0;
    in property <int> routing-mirror: 0;
    in property <int> routing-strategy: 1;
    in property <bool> routing-quic: false;
    in property <[PhoneRule]> rules;
    in property <string> routing-error: "";
    in property <string> rules-summary: "";
    in property <[PhoneProvider]> providers;
    callback routing-preset-changed(int);
    callback routing-mirror-changed(int);
    callback routing-strategy-changed(int);
    callback routing-quic-changed(bool);
    callback rule-add();
    callback rule-action-changed(int, int);
    callback rule-enabled-changed(int, bool);
    callback rule-delete(int);
    callback rule-values-changed(int, int, string);
    callback provider-enabled-changed(string, bool);
    callback provider-ignored-changed(string, bool);

    // Statistics tab
    in property <[PhoneStatCard]> stat-cards;
    in property <[PhoneDay]> stat-days;
    in property <[PhoneTop]> stat-top;

    // Settings tab
    in property <int> core-index: 0;
    in property <int> theme-index: 0;
    in property <int> language-index: 0;
    in-out property <string> dns-remote;
    in-out property <string> dns-direct;
    in-out property <string> dns-bootstrap;
    in-out property <string> ping-url;
    callback core-changed(int);
    callback theme-changed(int);
    callback language-changed(int);
    callback dns-save();
    callback ping-save();
    callback long-press-start();
    callback long-press-end();

    // About page (full screen, opened from Settings).
    in-out property <bool> about-open: false;

    // Hidden device id editor (opened by a long press on the version line).
    in property <bool> hwid-open: false;
    in property <string> hwid-auto;
    in-out property <string> hwid-input;
    in property <string> hwid-error;
    callback hwid-save();
    callback hwid-reset();
    callback hwid-close();

    // Subscription settings sheet (opened by a card's settings button).
    in-out property <bool> sheet-open: false;
    in-out property <string> sheet-name;
    in-out property <bool> sheet-ignore: false;
    in-out property <bool> sheet-delete-armed: false;
    in property <string> version-text: "";
    in property <string> log-text: "";
    callback add-subscription();
    callback import-links();
    callback import-clipboard();
    in-out property <string> add-url;
    in-out property <string> add-name;
    in-out property <string> add-backups;
    in-out property <string> links-text;
    callback refresh-logs();
    callback clear-logs();

    // Paint the area under the system status bar like the top bar.
    Rectangle {
        y: 0px;
        height: root.safe-area-insets.top;
        background: Theme.panel-bg;
    }

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        // top bar
        Rectangle {
            height: 56px;
            background: Theme.panel-bg;
            Text {
                x: 16px;
                text: "Flamix";
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // pages (only one visible)
        Rectangle {
            vertical-stretch: 1;
            min-height: 100px;

            // Серверы: connect button, selected server, search, subscription cards
            if root.tab == 0 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 104px;
                        height: 104px;
                        border-radius: 52px;
                        background: root.connected ? Theme.success : Theme.accent;
                        TouchArea {
                            clicked => { root.connect-pressed(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    width: 40px;
                                    height: 40px;
                                    source: @image-url("../../flamix/assets/icons/power.svg");
                                    colorize: Theme.on-accent;
                                }
                            }
                            Text {
                                text: root.connect-label;
                                color: Theme.on-accent;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: root.selected-name;
                    color: Theme.text;
                    font-size: 16px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if root.status-text != "" : Text {
                    text: root.status-text;
                    color: Theme.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                search := LineEdit {
                    height: 48px;
                    font-size: 15px;
                    placeholder-text: "Поиск серверов";
                    edited => { root.search-changed(self.text); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-bottom: 8px;
                        spacing: 10px;
                        for sub in root.subs : SubCardView {
                            sub: sub;
                            toggle => { root.sub-toggle(sub.id); }
                            pin => { root.sub-pin(sub.id); }
                            refresh => { root.sub-refresh(sub.id); }
                            settings => { root.sub-open-settings(sub.id); }
                            open-url(url) => { root.open-url(url); }
                            select-server(id) => { root.select-server(id); }
                        }
                        if root.subs.length == 0 : HorizontalLayout {
                                                        padding-top: 24px;
                                Text {
                                text: "Подписок пока нет. Добавьте ссылку на вкладке «Добавить».";
                                color: Theme.muted;
                                font-size: 14px;
                                wrap: word-wrap;
                                horizontal-alignment: center;
                            }
                            }
                    }
                }
            }

            // Добавить: subscription form, share links, clipboard import, status line
            if root.tab == 1 : ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: sub-card.preferred-height + 24px;
                        sub-card := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Подписка"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            LineEdit {
                                height: 48px;
                                font-size: 15px;
                                placeholder-text: "Ссылка на подписку (https://…)";
                                text <=> root.add-url;
                            }
                            LineEdit {
                                height: 48px;
                                font-size: 15px;
                                placeholder-text: "Название (необязательно)";
                                text <=> root.add-name;
                            }
                            TextEdit {
                                height: 96px;
                                font-size: 14px;
                                placeholder-text: "Резервные ссылки (необязательно), по одной в строке";
                                text <=> root.add-backups;
                            }
                            Btn {
                                text: "Добавить";
                                primary: true;
                                clicked => { root.add-subscription(); }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: links-card.preferred-height + 24px;
                        links-card := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Ссылки"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text {
                                text: "vless, vmess, trojan, ss, hy2, tuic, wg; подписки https://; диплинки flamix://, happ://, v2raytun:// — по одной в строке.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                            TextEdit {
                                height: 140px;
                                font-size: 14px;
                                placeholder-text: "vless://…\nvmess://…\ntrojan://…";
                                text <=> root.links-text;
                            }
                            Btn {
                                text: "Импортировать";
                                primary: true;
                                clicked => { root.import-links(); }
                            }
                        }
                    }

                    Btn {
                        text: "Из буфера обмена";
                        clicked => { root.import-clipboard(); }
                    }
                    if root.add-status != "" : Text {
                        text: root.add-status;
                        color: Theme.muted;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
            }

            // Маршрутизация: presets, Anixart mirror, custom rules, extra, provider routing
            if root.tab == 2 : ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    Text { text: "Пресеты"; color: Theme.muted; font-size: 13px; }
                    for preset[i] in [
                        { title: "Global", description: "Весь трафик через прокси" },
                        { title: "Обход РФ", description: "РФ-сайты напрямую, реклама блокируется" },
                        { title: "Свои правила", description: "Только ваши правила, остальное через прокси" },
                    ] : Rectangle {
                        height: 64px;
                        border-radius: Theme.radius;
                        background: root.routing-preset == i ? Theme.accent.with-alpha(0.22)
                            : (preset-ta.has-hover ? Theme.hover : Theme.card-body);
                        border-width: root.routing-preset == i ? 1px : 0px;
                        border-color: Theme.accent;
                        VerticalLayout {
                            x: 14px;
                            y: 8px;
                            width: parent.width - 28px;
                            height: parent.height - 16px;
                            alignment: center;
                            spacing: 2px;
                            Text { text: preset.title; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: preset.description; color: Theme.muted; font-size: 12px; overflow: elide; }
                        }
                        preset-ta := TouchArea { clicked => { root.routing-preset-changed(i); } }
                    }

                    if root.routing-preset == 1 : Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: mirror-col.preferred-height + 24px;
                        mirror-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Зеркало Anixart"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 6px;
                                Chip { horizontal-stretch: 1; text: "Напрямую"; selected: root.routing-mirror == 0; clicked => { root.routing-mirror-changed(0); } }
                                Chip { horizontal-stretch: 1; text: "Через прокси"; selected: root.routing-mirror == 1; clicked => { root.routing-mirror-changed(1); } }
                            }
                            Text {
                                text: "Куда идут anixart.tv и anixstatic.com: напрямую (по умолчанию в РФ) или через прокси, если зеркало недоступно.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: rules-col.preferred-height + 24px;
                        rules-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Свои правила";
                                    color: Theme.text;
                                    font-size: 15px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.rules-summary;
                                    color: Theme.muted;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }
                            Chip { text: "+ Добавить правило"; tint: Theme.accent; selected: true; clicked => { root.rule-add(); } }
                            for rule in root.rules : RuleView {
                                rule: rule;
                                action-changed(a) => { root.rule-action-changed(rule.index, a); }
                                enabled-changed(v) => { root.rule-enabled-changed(rule.index, v); }
                                delete-rule => { root.rule-delete(rule.index); }
                                values-edited(kind, text) => { root.rule-values-changed(rule.index, kind, text); }
                            }
                            if root.rules.length == 0 : Text {
                                text: "Нет правил — трафик пойдёт по выбранному пресету";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            if root.routing-error != "" : Text {
                                text: root.routing-error;
                                color: Theme.danger;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            Text {
                                text: "Формат Xray: geosite:category-ru, domain:example.com, geoip:ru, 10.0.0.0/8, telegram.exe. Значения через запятую или с новой строки.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: extra-col.preferred-height + 24px;
                        extra-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 10px;
                            Text { text: "Дополнительно"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: "Стратегия доменов"; color: Theme.muted; font-size: 13px; }
                            HorizontalLayout {
                                spacing: 6px;
                                Chip { horizontal-stretch: 1; text: "AsIs"; selected: root.routing-strategy == 0; clicked => { root.routing-strategy-changed(0); } }
                                Chip { horizontal-stretch: 1; text: "IPIfNonMatch"; selected: root.routing-strategy == 1; clicked => { root.routing-strategy-changed(1); } }
                                Chip { horizontal-stretch: 1; text: "IPOnDemand"; selected: root.routing-strategy == 2; clicked => { root.routing-strategy-changed(2); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Блокировать QUIC";
                                    color: Theme.text;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                Switch {
                                    checked: root.routing-quic;
                                    toggled => { root.routing-quic-changed(self.checked); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: provider-col.preferred-height + 24px;
                        provider-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 10px;
                            Text { text: "Маршрутизация провайдера"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            if root.providers.length == 0 : Text {
                                text: "В ваших подписках нет маршрутизации провайдера";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                            for provider in root.providers : VerticalLayout {
                                spacing: 4px;
                                Text { text: provider.name; color: Theme.text; font-size: 14px; overflow: elide; }
                                if provider.rules-text != "" : Text { text: provider.rules-text; color: Theme.muted; font-size: 12px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Включена";
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    Switch {
                                        checked: provider.enabled;
                                        enabled: provider.rules-text != "";
                                        toggled => { root.provider-enabled-changed(provider.id, self.checked); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: "Игнорировать маршрутизацию";
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }
                                    Switch {
                                        checked: provider.ignored;
                                        toggled => { root.provider-ignored-changed(provider.id, self.checked); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Статистика: totals, 30-day columns, busiest servers
            if root.tab == 4 : ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;
                    Text { text: "Статистика"; color: Theme.text; font-size: 20px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 6px;
                        for card in root.stat-cards : Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.card-body;
                            border-radius: Theme.radius;
                            height: stat-col.preferred-height + 20px;
                            stat-col := VerticalLayout {
                                x: 8px;
                                y: 10px;
                                width: parent.width - 16px;
                                spacing: 3px;
                                Text { text: card.title; color: Theme.muted; font-size: 12px; overflow: elide; }
                                Text { text: card.value; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                                Text { text: card.up; color: Theme.muted; font-size: 11px; overflow: elide; }
                                Text { text: card.down; color: Theme.muted; font-size: 11px; overflow: elide; }
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: chart-col.preferred-height + 24px;
                        chart-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "За 30 дней"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: "Оранжевый — отправлено, синий — получено за день"; color: Theme.muted; font-size: 11px; wrap: word-wrap; }
                            Rectangle {
                                height: 160px;
                                HorizontalLayout {
                                    spacing: 2px;
                                    alignment: stretch;
                                    for day in root.stat-days : Rectangle {
                                        horizontal-stretch: 1;
                                        background: transparent;
                                        // upload (bottom, accent)
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width;
                                            height: max(parent.height * day.up, 0px);
                                            y: parent.height - self.height;
                                            background: Theme.accent;
                                            border-radius: 2px;
                                        }
                                        // download (on top of upload, info blue)
                                        Rectangle {
                                            x: 0px;
                                            width: parent.width;
                                            height: max(parent.height * day.down, 0px);
                                            y: parent.height - parent.height * day.up - self.height;
                                            background: Theme.info;
                                            border-radius: 2px;
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 2px;
                                for day in root.stat-days : Rectangle {
                                    horizontal-stretch: 1;
                                    height: 14px;
                                    Text {
                                        width: parent.width + 24px;
                                        x: -12px;
                                        text: day.label;
                                        color: Theme.muted;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: top-col.preferred-height + 24px;
                        top-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 10px;
                            Text { text: "Самые используемые серверы"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            for entry in root.stat-top : VerticalLayout {
                                spacing: 4px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: entry.iso + "  " + entry.name;
                                        color: Theme.text;
                                        font-size: 14px;
                                        overflow: elide;
                                    }
                                    Text { text: entry.used; color: Theme.muted; font-size: 12px; }
                                }
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.track;
                                    Rectangle {
                                        x: 0px;
                                        width: min(parent.width * entry.fraction, parent.width);
                                        height: parent.height;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                    }
                                }
                            }
                            if root.stat-top.length == 0 : Text {
                                text: "Пока нет данных: трафик считается по мере работы VPN.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // Настройки: connection, core, DNS, ping URL, interface, version, logs
            if root.tab == 3 : ScrollView {
                VerticalLayout {
                    padding: 12px;
                    spacing: 12px;

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: conn-col.preferred-height + 24px;
                        conn-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 6px;
                            Text { text: "Режим подключения"; color: Theme.muted; font-size: 12px; }
                            Text { text: "VPN (весь трафик устройства)"; color: Theme.text; font-size: 16px; font-weight: 600; wrap: word-wrap; }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: core-col.preferred-height + 24px;
                        core-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Ядро"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                Chip { horizontal-stretch: 1; text: "Авто"; selected: root.core-index == 0; clicked => { root.core-changed(0); } }
                                Chip { horizontal-stretch: 1; text: "Xray"; selected: root.core-index == 1; clicked => { root.core-changed(1); } }
                                Chip { horizontal-stretch: 1; text: "sing-box"; selected: root.core-index == 2; clicked => { root.core-changed(2); } }
                                Chip { horizontal-stretch: 1; text: "mihomo"; selected: root.core-index == 3; clicked => { root.core-changed(3); } }
                            }
                            Text {
                                text: "На Android VPN работает на sing-box: выбор Xray или mihomo сохраняется, но на телефоне не применяется.";
                                color: Theme.muted;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: dns-col.preferred-height + 24px;
                        dns-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "DNS"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: "Через прокси"; color: Theme.muted; font-size: 12px; }
                            LineEdit { height: 48px; font-size: 14px; placeholder-text: "https://1.1.1.1/dns-query"; text <=> root.dns-remote; }
                            Text { text: "Напрямую"; color: Theme.muted; font-size: 12px; }
                            LineEdit { height: 48px; font-size: 14px; placeholder-text: "https://77.88.8.8/dns-query"; text <=> root.dns-direct; }
                            Text { text: "Bootstrap (IP, необязательно)"; color: Theme.muted; font-size: 12px; }
                            LineEdit { height: 48px; font-size: 14px; placeholder-text: "77.88.8.8"; text <=> root.dns-bootstrap; }
                            Btn { text: "Сохранить DNS"; primary: true; clicked => { root.dns-save(); } }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: ping-col.preferred-height + 24px;
                        ping-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Адрес для проверки задержки"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            LineEdit { height: 48px; font-size: 14px; placeholder-text: "https://www.gstatic.com/generate_204"; text <=> root.ping-url; }
                            Btn { text: "Сохранить адрес"; primary: true; clicked => { root.ping-save(); } }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: ui-col.preferred-height + 24px;
                        ui-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Тема"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                Chip { horizontal-stretch: 1; text: "Системная"; selected: root.theme-index == 0; clicked => { root.theme-changed(0); } }
                                Chip { horizontal-stretch: 1; text: "Тёмная"; selected: root.theme-index == 1; clicked => { root.theme-changed(1); } }
                                Chip { horizontal-stretch: 1; text: "Светлая"; selected: root.theme-index == 2; clicked => { root.theme-changed(2); } }
                            }
                            Text { text: "Язык"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 4px;
                                Chip { horizontal-stretch: 1; text: "Русский"; selected: root.language-index == 0; clicked => { root.language-changed(0); } }
                                Chip { horizontal-stretch: 1; text: "English"; selected: root.language-index == 1; clicked => { root.language-changed(1); } }
                            }
                        }
                    }

                    // The version line: a long press opens the device id editor (not documented).
                    Rectangle {
                        height: 48px;
                        background: version-ta.has-hover ? Theme.hover : transparent;
                        border-radius: Theme.radius;
                        version-ta := TouchArea {
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) { root.long-press-start(); }
                                if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) { root.long-press-end(); }
                            }
                        }
                        Text {
                            x: 12px;
                            width: parent.width - 24px;
                            height: parent.height;
                            text: "Версия: " + root.version-text;
                            color: Theme.muted;
                            font-size: 14px;
                            vertical-alignment: center;
                        }
                    }

                    // Opens the About page (licences, links).
                    Rectangle {
                        height: 56px;
                        background: about-ta.has-hover ? Theme.hover : Theme.card-body;
                        border-radius: Theme.radius;
                        about-ta := TouchArea { clicked => { root.about-open = true; } }
                        HorizontalLayout {
                            x: 14px;
                            width: parent.width - 28px;
                            height: parent.height;
                            spacing: 8px;
                            Text {
                                horizontal-stretch: 1;
                                text: "О программе";
                                color: Theme.text;
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Image {
                                width: 16px;
                                height: 16px;
                                y: (parent.height - self.height) / 2;
                                source: @image-url("../../flamix/assets/icons/chevron-right.svg");
                                colorize: Theme.muted;
                            }
                        }
                    }

                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: log-col.preferred-height + 24px;
                        log-col := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 8px;
                            Text { text: "Логи"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 8px;
                                Btn { horizontal-stretch: 1; text: "Обновить"; clicked => { root.refresh-logs(); } }
                                Btn { horizontal-stretch: 1; text: "Очистить"; primary: true; clicked => { root.clear-logs(); } }
                            }
                            Rectangle {
                                height: 260px;
                                background: Theme.panel-bg;
                                border-radius: 8px;
                                clip: true;
                                log-view := ScrollView {
                                    x: 0px;
                                    y: 0px;
                                    width: parent.width;
                                    height: parent.height;
                                    // Starts scrolled to the bottom (newest lines) until the user scrolls.
                                    content-y: min(0px, self.visible-height - self.content-height);
                                    VerticalLayout {
                                        padding: 8px;
                                        Text {
                                            text: root.log-text == "" ? "Лог пуст" : root.log-text;
                                            color: Theme.muted;
                                            font-size: 11px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }

        // bottom tabs (each at least 48 dp high; widths follow the label text)
        Rectangle {
            height: 60px;
            background: Theme.panel-bg;
            HorizontalLayout {
                BottomTab {
                    label: "Серверы";
                    icon: @image-url("../../flamix/assets/icons/list.svg");
                    active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                BottomTab {
                    label: "Добавить";
                    icon: @image-url("../../flamix/assets/icons/add.svg");
                    active: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                BottomTab {
                    label: "Маршрутизация";
                    icon: @image-url("../../flamix/assets/icons/routing.svg");
                    active: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
                BottomTab {
                    label: "Настройки";
                    icon: @image-url("../../flamix/assets/icons/settings.svg");
                    active: root.tab == 3;
                    clicked => { root.tab = 3; }
                }
                BottomTab {
                    label: "Статистика";
                    icon: @image-url("../../flamix/assets/icons/stats.svg");
                    active: root.tab == 4;
                    clicked => { root.tab = 4; }
                }
            }
        }
    }

    // Device id editor (hidden feature).
    if root.hwid-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #000000B3;
        TouchArea { clicked => { root.hwid-close(); } }
        Rectangle {
            x: 0px;
            y: parent.height - self.height;
            width: parent.width;
            height: hwid-col.preferred-height + 32px;
            background: Theme.panel-bg;
            border-radius: 16px;
            TouchArea { }
            hwid-col := VerticalLayout {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                spacing: 10px;
                Text { text: "Идентификатор устройства"; color: Theme.text; font-size: 18px; font-weight: 600; }
                Text { text: "Автоматический"; color: Theme.muted; font-size: 13px; }
                LineEdit { height: 48px; font-size: 14px; read-only: true; text: root.hwid-auto; }
                Text { text: "Свой HWID"; color: Theme.muted; font-size: 13px; }
                LineEdit { height: 48px; font-size: 15px; text <=> root.hwid-input; }
                if root.hwid-error != "" : Text {
                    text: root.hwid-error;
                    color: Theme.danger;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn { horizontal-stretch: 1; text: "Сохранить"; primary: true; clicked => { root.hwid-save(); } }
                    Btn { horizontal-stretch: 1; text: "Сбросить"; clicked => { root.hwid-reset(); } }
                }
                Btn { text: "Закрыть"; clicked => { root.hwid-close(); } }
            }
        }
    }

    // About page: version, description, licences, links as selectable text.
    if root.about-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.window-bg;
        VerticalLayout {
            padding-top: root.safe-area-insets.top + 8px;
            padding-bottom: 12px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 12px;
            HorizontalLayout {
                height: 48px;
                spacing: 8px;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: close-ta.has-hover ? Theme.hover : transparent;
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 22px;
                        height: 22px;
                        source: @image-url("../../flamix/assets/icons/close.svg");
                        colorize: Theme.text;
                    }
                    close-ta := TouchArea { clicked => { root.about-open = false; } }
                }
                Text {
                    horizontal-stretch: 1;
                    text: "О программе";
                    color: Theme.text;
                    font-size: 20px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            ScrollView {
                VerticalLayout {
                    spacing: 12px;
                    padding-bottom: 16px;
                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: about-main.preferred-height + 24px;
                        about-main := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 6px;
                            Text { text: "Flamix"; color: Theme.text; font-size: 20px; font-weight: 600; }
                            Text { text: "Версия " + root.version-text; color: Theme.text; font-size: 14px; }
                            Text {
                                text: "Кроссплатформенный VPN-клиент на Rust с интерфейсом Slint.";
                                color: Theme.muted;
                                font-size: 13px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: about-links.preferred-height + 24px;
                        about-links := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 6px;
                            Text { text: "Ссылки"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: "Исходный код"; color: Theme.muted; font-size: 12px; }
                            TextInput {
                                read-only: true;
                                font-size: 14px;
                                text: "https://github.com/lavrentijav/flamix-client";
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            Text { text: "Релизы"; color: Theme.muted; font-size: 12px; }
                            TextInput {
                                read-only: true;
                                font-size: 14px;
                                text: "https://github.com/lavrentijav/flamix-client/releases";
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                            Text { text: "Сообщить о проблеме"; color: Theme.muted; font-size: 12px; }
                            TextInput {
                                read-only: true;
                                font-size: 14px;
                                text: "https://github.com/lavrentijav/flamix-client/issues";
                                color: Theme.text;
                                wrap: word-wrap;
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.card-body;
                        border-radius: Theme.radius;
                        height: about-lic.preferred-height + 24px;
                        about-lic := VerticalLayout {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            spacing: 6px;
                            Text { text: "Лицензии"; color: Theme.text; font-size: 15px; font-weight: 600; }
                            Text { text: "Flamix — GPL-3.0-or-later"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            Text { text: "Xray-core — MPL-2.0"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            Text { text: "sing-box — GPL-3.0"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            Text { text: "Slint — royalty-free / GPL-3.0"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                            Text { text: "Иконки Alfa-Bank — MIT"; color: Theme.muted; font-size: 13px; wrap: word-wrap; }
                        }
                    }
                }
            }
        }
    }
}
