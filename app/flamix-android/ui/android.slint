// Phone layout of Flamix (M4). The window is shown by the Android entry point (src/lib.rs).
// Dark colours are copied from app/flamix/ui/theme.slint (keep in sync).
import { LineEdit, ListView, ScrollView } from "std-widgets.slint";

global Theme {
    out property <color> window-bg: #2B2621;
    out property <color> panel-bg: #3D3328;
    out property <color> card-header: #5A4632;
    out property <color> accent: #C07A2C;
    out property <color> text: #F2E9DF;
    out property <color> muted: #B9A894;
    out property <color> success: #6CCB5F;
    out property <color> on-accent: #FFFFFF;
    out property <color> stroke: #FFFFFF14;
    out property <length> radius: 10px;
}

export struct ServerItem {
    name: string,
    subtitle: string,
    address: string,
    /// true = measured exit IP, false = entry address (shown with a small "вход" label)
    is-exit: bool,
    /// servers sharing this exit IP (0 = unique/unknown)
    group: int,
    selected: bool,
}

component BottomTab inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    background: transparent;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: center;
            Image {
                width: 24px;
                height: 24px;
                source: root.icon;
                colorize: root.active ? Theme.accent : Theme.muted;
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
}

export component AndroidWindow inherits Window {
    title: "Flamix";
    background: Theme.window-bg;
    preferred-width: 360px;
    preferred-height: 720px;

    in property <[ServerItem]> servers;
    in property <string> selected-name: "Сервер не выбран";
    in property <string> status-text: "";
    in property <string> connect-label: "Подключить";
    in property <bool> connected: false;
    in property <string> add-status: "";
    in-out property <int> tab: 0;   // 0 = Серверы, 1 = Добавить, 2 = Настройки

    callback select-server(int);
    callback connect-pressed();
    in property <string> version-text: "";
    in property <string> log-text: "";
    callback add-subscription(string);
    callback refresh-logs();
    callback clear-logs();

    // Paint the area under the system status bar like the top bar.
    Rectangle {
        y: 0px;
        height: root.safe-area-insets.top;
        background: Theme.panel-bg;
    }

    VerticalLayout {
        padding-top: root.safe-area-insets.top;
        padding-bottom: root.safe-area-insets.bottom;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        // top bar
        Rectangle {
            height: 56px;
            background: Theme.panel-bg;
            Text {
                x: 16px;
                text: "Flamix";
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // pages (only one visible)
        Rectangle {
            vertical-stretch: 1;
            min-height: 100px;

            // Серверы: connect button, selected server, server list
            if root.tab == 0 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 16px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 152px;
                        height: 152px;
                        border-radius: 76px;
                        background: root.connected ? Theme.success : Theme.accent;
                        TouchArea {
                            clicked => { root.connect-pressed(); }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: center;
                                Image {
                                    width: 48px;
                                    height: 48px;
                                    source: @image-url("../../flamix/assets/icons/power.svg");
                                    colorize: Theme.on-accent;
                                }
                            }
                            Text {
                                text: root.connect-label;
                                color: Theme.on-accent;
                                font-size: 15px;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: root.selected-name;
                    color: Theme.text;
                    font-size: 18px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.status-text;
                    color: Theme.muted;
                    font-size: 14px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                ListView {
                    vertical-stretch: 1;
                    for server[i] in root.servers : Rectangle {
                        height: 64px;
                        border-radius: Theme.radius;
                        background: server.selected ? Theme.card-header : Theme.panel-bg;
                        TouchArea {
                            clicked => { root.select-server(i); }
                        }
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: center;
                            Text {
                                text: server.name;
                                color: Theme.text;
                                font-size: 16px;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Text {
                                    text: server.address;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                                if !server.is-exit : Text {
                                    text: "вход";
                                    color: Theme.muted;
                                    font-size: 10px;
                                    vertical-alignment: center;
                                }
                                if server.group > 1 : Text {
                                    text: "×" + server.group;
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: server.subtitle;
                                    color: Theme.muted;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // Добавить: subscription URL
            if root.tab == 1 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Ссылка на подписку";
                    color: Theme.muted;
                    font-size: 14px;
                }
                url := LineEdit {
                    height: 48px;
                    font-size: 16px;
                    placeholder-text: "https://";
                    accepted => { root.add-subscription(self.text); }
                }
                Rectangle {
                    height: 48px;
                    border-radius: Theme.radius;
                    background: Theme.accent;
                    TouchArea {
                        clicked => { root.add-subscription(url.text); }
                    }
                    Text {
                        text: "Добавить";
                        color: Theme.on-accent;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.add-status;
                    color: Theme.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                Rectangle {
                    vertical-stretch: 1;
                }
            }

            // Настройки: connection mode, version, logs
            if root.tab == 2 : VerticalLayout {
                width: parent.width;
                height: parent.height;
                padding: 16px;
                spacing: 8px;
                Text {
                    text: "Режим подключения";
                    color: Theme.muted;
                    font-size: 14px;
                }
                Text {
                    text: "VPN (весь трафик устройства)";
                    color: Theme.text;
                    font-size: 16px;
                }
                Text {
                    text: "Версия: " + root.version-text;
                    color: Theme.text;
                    font-size: 14px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Логи";
                        color: Theme.muted;
                        font-size: 14px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 110px;
                        height: 40px;
                        border-radius: Theme.radius;
                        background: Theme.panel-bg;
                        TouchArea { clicked => { root.refresh-logs(); } }
                        Text { text: "Обновить"; color: Theme.text; font-size: 14px;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 110px;
                        height: 40px;
                        border-radius: Theme.radius;
                        background: Theme.accent;
                        TouchArea { clicked => { root.clear-logs(); } }
                        Text { text: "Очистить"; color: Theme.on-accent; font-size: 14px;
                            horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.panel-bg;
                    border-radius: Theme.radius;
                    ScrollView {
                        x: 8px;
                        y: 8px;
                        width: parent.width - 16px;
                        height: parent.height - 16px;
                        Text {
                            width: parent.width;
                            text: root.log-text == "" ? "Лог пуст" : root.log-text;
                            color: Theme.muted;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // bottom tabs (each at least 48 dp high)
        Rectangle {
            height: 56px;
            background: Theme.panel-bg;
            HorizontalLayout {
                BottomTab {
                    label: "Серверы";
                    icon: @image-url("../../flamix/assets/icons/list.svg");
                    active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                BottomTab {
                    label: "Добавить";
                    icon: @image-url("../../flamix/assets/icons/add.svg");
                    active: root.tab == 1;
                    clicked => { root.tab = 1; }
                }
                BottomTab {
                    label: "Настройки";
                    icon: @image-url("../../flamix/assets/icons/settings.svg");
                    active: root.tab == 2;
                    clicked => { root.tab = 2; }
                }
            }
        }
    }
}
