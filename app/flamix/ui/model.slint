// Shared UI data model. Re-exported from `app.slint` (see the T07 contract).

export enum ConnState {
    disconnected,
    connecting,
    connected,
    error,
}

export struct ServerItem {
    id: string,
    name: string,
    country: string,
    flag: image,
    summary: string,
    // -2 = untested, -1 = failed, otherwise latency in ms.
    ping: int,
    has-quota: bool,
    quota-fraction: float,
    quota-text: string,
    selected: bool,
    // Measured public exit IP (empty when never probed).
    exit-ip: string,
    // 0 = no measured exit or a unique exit, otherwise the number of servers (>1) sharing it.
    exit-group: int,
}

export struct SubscriptionItem {
    id: string,
    name: string,
    pinned: bool,
    collapsed: bool,
    updating: bool,
    has-traffic: bool,
    traffic-fraction: float,
    traffic-text: string,
    expire-text: string,
    announce: string,
    // Support link: kind 0 = none, 1 = Telegram, 2 = e-mail, 3 = website/chat.
    support-url: string,
    support-kind: int,
    // Provider site (`profile-web-page-url`), empty when unset.
    web-url: string,
    // Announcement banner above the server list (empty text = none). `banner-tone`:
    // 0 info/blue, 1 red, 2 green, 3 custom (`banner-color`), 4 warning (expiry notice).
    banner-text: string,
    banner-tone: int,
    banner-color: color,
    banner-button-text: string,
    banner-link: string,
    error: string,
    servers: [ServerItem],
}
