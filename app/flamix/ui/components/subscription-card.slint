import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { IconButton } from "icon-button.slint";
import { Banner } from "banner.slint";
import { SubscriptionItem } from "../model.slint";
import { ServerRow } from "server-row.slint";

export component SubscriptionCard inherits Rectangle {
    in property <SubscriptionItem> sub;
    in property <bool> edit-mode: false;

    callback toggle-collapse();
    callback toggle-pin();
    callback refresh();
    callback settings();
    callback delete-sub();
    callback open-url(string);
    callback select-server(string);
    callback open-server(string);
    callback delete-server(string);

    background: Theme.card-body;
    border-radius: 12px;
    clip: true;
    // Size to content (the root is a Rectangle, so adopt the layout's preferred height).
    height: content.preferred-height;

    content := VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Header: chevron + name on the left (click collapses), 28px action slots on the right.
        Rectangle {
            height: 44px;
            background: Theme.card-header;

            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggle-collapse(); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 6px;
                spacing: 2px;
                cross-axis-alignment: center;

                Rectangle {
                    width: 26px;
                    height: 28px;
                    Icon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        size: 16px;
                        source: @image-url("../../assets/icons/chevron-down.svg");
                        tint: Theme.text;
                        transform-rotation: sub.collapsed ? -90deg : 0deg;
                        animate transform-rotation { duration: 160ms; }
                    }
                }
                Text {
                    horizontal-stretch: 1;
                    text: sub.name;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // Shown only when the provider sent the corresponding link.
                if sub.support-kind != 0 : IconButton {
                    icon: sub.support-kind == 1 ? @image-url("../../assets/icons/telegram.svg")
                        : sub.support-kind == 2 ? @image-url("../../assets/icons/mail.svg")
                        : @image-url("../../assets/icons/support.svg");
                    tint: Theme.accent;
                    clicked => { root.open-url(sub.support-url); }
                }
                if sub.web-url != "" : IconButton {
                    icon: @image-url("../../assets/icons/globe.svg");
                    tint: Theme.accent;
                    clicked => { root.open-url(sub.web-url); }
                }
                IconButton {
                    icon: @image-url("../../assets/icons/pin.svg");
                    tint: sub.pinned ? Theme.accent : Theme.muted;
                    clicked => { root.toggle-pin(); }
                }
                IconButton {
                    icon: @image-url("../../assets/icons/refresh.svg");
                    spinning: sub.updating;
                    clicked => { root.refresh(); }
                }
                IconButton {
                    icon: @image-url("../../assets/icons/settings.svg");
                    clicked => { root.settings(); }
                }
                if edit-mode : IconButton {
                    icon: @image-url("../../assets/icons/trash.svg");
                    tint: Theme.danger;
                    clicked => { root.delete-sub(); }
                }
            }
        }

        // Traffic: used / total and expiry on one line, the quota bar below.
        if sub.has-traffic : VerticalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: sub.traffic-text;
                    color: Theme.text;
                    font-size: 12px;
                    overflow: elide;
                }
                if sub.expire-text != "" : Text {
                    text: sub.expire-text;
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: right;
                }
            }
            Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.track;
                Rectangle {
                    x: 0;
                    width: min(parent.width * sub.traffic-fraction, parent.width);
                    height: parent.height;
                    border-radius: 2px;
                    background: Theme.accent;
                }
            }
        }

        // Provider announcement / expiry notice.
        if sub.banner-text != "" : VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 8px;
            padding-bottom: 4px;
            Banner {
                text: sub.banner-text;
                tone: sub.banner-tone;
                custom: sub.banner-color;
                button-text: sub.banner-button-text;
                button-clicked => { root.open-url(sub.banner-link); }
            }
        }

        // Plain announce / error lines.
        if sub.announce != "" : HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            padding-bottom: 2px;
            Text {
                text: sub.announce;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        if sub.error != "" : HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 6px;
            padding-bottom: 2px;
            Text {
                text: sub.error;
                color: Theme.danger;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // Servers.
        if !sub.collapsed : VerticalLayout {
            padding: 4px;
            spacing: 0px;
            for s in sub.servers : ServerRow {
                item: s;
                edit-mode: root.edit-mode;
                clicked => { root.select-server(s.id); }
                open => { root.open-server(s.id); }
                delete-clicked => { root.delete-server(s.id); }
            }
        }
        if sub.collapsed : Rectangle { height: 6px; }
    }
}
