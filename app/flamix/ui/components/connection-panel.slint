import { Theme } from "../theme.slint";
import { Icon } from "icon.slint";
import { PowerButton } from "power-button.slint";
import { ConnState } from "../model.slint";

export component ConnectionPanel inherits Rectangle {
    in property <image> selected-flag;
    in property <string> selected-name;
    in property <string> ping-result;
    in property <ConnState> state;
    in property <string> status-text;
    in property <string> speed-text;
    in property <bool> needs-admin: false;
    // 0 Proxy, 1 TUN, 2 TProxy.
    in-out property <int> mode-index: 0;
    callback toggle-connect();
    callback ping-selected();
    callback mode-changed(int);
    callback restart-as-admin();

    width: 300px;
    background: Theme.panel-bg;
    border-radius: 16px;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;

        // Power button.
        Rectangle {
            height: 178px;
            background: transparent;
            PowerButton {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 150px;
                height: 150px;
                state: root.state;
                clicked => { root.toggle-connect(); }
            }
        }

        // Selected server.
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Image {
                width: 24px;
                height: 18px;
                source: root.selected-flag;
            }
            Text {
                text: root.selected-name;
                color: Theme.text;
                font-size: 15px;
                vertical-alignment: center;
            }
        }

        // Ping button.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 168px;
                height: 36px;
                border-radius: 8px;
                background: ping-ta.has-hover ? Theme.hover : Theme.control-bg;
                border-width: 1px;
                border-color: Theme.stroke;
                // Icon and text vertically centered on one line.
                HorizontalLayout {
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: 8px;
                    Icon {
                        width: 16px;
                        height: 16px;
                        source: @image-url("../../assets/icons/ping.svg");
                        tint: Theme.text;
                    }
                    Text {
                        text: "Тест пинга" + root.ping-result;
                        color: Theme.text;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }
                ping-ta := TouchArea { mouse-cursor: pointer; clicked => { root.ping-selected(); } }
            }
        }

        // Proxy / TUN / TProxy segmented control.
        Rectangle {
            height: 34px;
            border-radius: 8px;
            background: Theme.track;
            HorizontalLayout {
                padding: 4px;
                spacing: 4px;
                for option[i] in ["Proxy", "TUN", "TProxy"] : Rectangle {
                    horizontal-stretch: 1;
                    border-radius: 6px;
                    background: i == root.mode-index ? Theme.accent : (mode-ta.has-hover ? Theme.hover : transparent);
                    Text {
                        text: option;
                        color: i == root.mode-index ? Theme.on-accent : Theme.muted;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    mode-ta := TouchArea { mouse-cursor: pointer; clicked => { root.mode-changed(i); } }
                }
            }
        }

        Text {
            text: root.status-text;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
        }
        // Shown when TUN needs elevation (Windows): offer to restart as administrator.
        if root.needs-admin : Rectangle {
            height: 34px;
            border-radius: 8px;
            background: admin-ta.has-hover ? Theme.accent-strong : Theme.accent;
            Text {
                text: "Перезапустить от администратора";
                color: Theme.on-accent;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            admin-ta := TouchArea { mouse-cursor: pointer; clicked => { root.restart-as-admin(); } }
        }
        if root.state == ConnState.connected : Text {
            text: root.speed-text;
            color: Theme.text;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
