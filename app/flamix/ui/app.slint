// Flamix main window. Rust <-> UI contract for the controller task (T07).
// Bundle a font so the software renderer works on machines without system fonts.
import "../assets/fonts/DejaVuSans.ttf";
import "../assets/fonts/DejaVuSans-Bold.ttf";
// Re-exported so Rust can switch the theme via `ui.global::<Theme>().set_dark(..)`.
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
// std-widgets (LineEdit, TextEdit, ComboBox, Button, …) paint from the global `Palette`, whose
// colour scheme defaults to the OS one — Rust forces it to follow our theme (see `apply_theme`).
import { Palette } from "std-widgets.slint";
export { Palette } from "std-widgets.slint";
import { Rail } from "components/rail.slint";
import { ServersPanel } from "components/servers-panel.slint";
import { ConnectionPanel } from "components/connection-panel.slint";
import { HwidDialog } from "components/hwid-dialog.slint";
import { AddPage, AddBridge } from "pages/add-page.slint";
import { RoutingPage, RoutingBridge } from "pages/routing-page.slint";
import { SettingsPage, SettingsBridge } from "pages/settings-page.slint";
import { StatsPage, StatsBridge } from "pages/stats-page.slint";
import { AboutPage, AboutBridge } from "pages/about-page.slint";
export { AddBridge, RoutingBridge, SettingsBridge, StatsBridge, AboutBridge }
import { ServerItem, SubscriptionItem, ConnState } from "model.slint";
export { ServerItem, SubscriptionItem, ConnState } from "model.slint";

export component AppWindow inherits Window {
    title: "Flamix";
    background: Theme.window-bg;
    preferred-width: 960px;
    preferred-height: 600px;
    min-width: 720px;
    min-height: 480px;
    default-font-family: root.font-family;

    in property <[SubscriptionItem]> subscriptions;
    in property <[ServerItem]> local-servers;
    in property <string> selected-name;
    in property <image> selected-flag;
    in property <string> ping-result;
    in property <ConnState> state: ConnState.disconnected;
    in property <string> status-text;
    in property <string> speed-text;
    in property <bool> needs-admin: false;
    in-out property <int> mode-index: 0; // 0 Proxy, 1 TUN, 2 TProxy
    in-out property <string> search-text;
    in property <bool> dark: true;
    // Segoe-first for the WinUI look; the screenshot switches this to the bundled font.
    in-out property <string> font-family: "Segoe UI Variable";
    in-out property <int> page: 0; // 0 servers, 1 add, 2 routing, 3 settings, 4 stats, 5 about
    in-out property <bool> edit-mode: false;
    in-out property <bool> rail-expanded: false;
    // "⋯" menu of the servers panel (exposed for screenshots).
    in-out property <bool> menu-open: false;

    callback toggle-connect();
    callback select-server(string);
    callback open-server(string);
    callback ping-selected();
    callback ping-all();
    callback check-exit-ips();
    callback update-subscription(string);
    callback update-all();
    callback toggle-pin(string);
    callback toggle-collapse(string);
    callback subscription-settings(string);
    callback delete-server(string);
    callback delete-subscription(string);
    callback import-clipboard();
    callback sort-by-ping();
    callback mode-changed(int);
    callback search-changed(string);
    callback toggle-edit();
    callback add-subscription();
    callback restart-as-admin();
    // Opens a provider/support/site link (the controller allows http, https, tg and mailto only).
    callback open-url(string);

    // HWID dialog (opened by a hidden key shortcut, see `keys` below; intentionally not in any menu).
    in-out property <bool> hwid-open: false;
    in property <string> device-id;
    in-out property <string> hwid-input;
    in-out property <string> hwid-error;
    callback hwid-opened();
    callback hwid-save(string);
    callback hwid-reset();

    public function show-hwid() {
        root.hwid-error = "";
        root.hwid-open = true;
        root.hwid-opened();
    }

    init => { keys.focus(); }

    keys := FocusScope {
      key-pressed(event) => {
        // `control` is Cmd on macOS in Slint.
        if (event.modifiers.control && event.modifiers.shift && (event.text == "h" || event.text == "H" || event.text == "\u{8}")) {
            root.show-hwid();
            return accept;
        }
        reject
      }

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        HorizontalLayout {
            spacing: 8px;
            vertical-stretch: 1;

            rail := Rail {
                page: root.page;
                expanded <=> root.rail-expanded;
                navigate(p) => { root.page = p; }
            }

            if root.page == 0 : ServersPanel {
                horizontal-stretch: 1;
                subscriptions: root.subscriptions;
                local-servers: root.local-servers;
                search-text <=> root.search-text;
                edit-mode: root.edit-mode;
                search-changed(q) => { root.search-changed(q); }
                toggle-edit => { root.toggle-edit(); }
                import-clipboard => { root.import-clipboard(); }
                update-all => { root.update-all(); }
                ping-all => { root.ping-all(); }
                check-exit-ips => { root.check-exit-ips(); }
                menu-open <=> root.menu-open;
                open-url(url) => { root.open-url(url); }
                sort-by-ping => { root.sort-by-ping(); }
                add-subscription => { root.add-subscription(); }
                toggle-collapse(id) => { root.toggle-collapse(id); }
                toggle-pin(id) => { root.toggle-pin(id); }
                refresh(id) => { root.update-subscription(id); }
                subscription-settings(id) => { root.subscription-settings(id); }
                delete-subscription(id) => { root.delete-subscription(id); }
                select-server(id) => { root.select-server(id); }
                open-server(id) => { root.open-server(id); }
                delete-server(id) => { root.delete-server(id); }
            }
            if root.page == 1 : AddPage { horizontal-stretch: 1; }
            if root.page == 2 : RoutingPage { horizontal-stretch: 1; }
            if root.page == 3 : SettingsPage { horizontal-stretch: 1; }
            if root.page == 4 : StatsPage { horizontal-stretch: 1; }
            if root.page == 5 : AboutPage { horizontal-stretch: 1; }

            ConnectionPanel {
                selected-flag: root.selected-flag;
                selected-name: root.selected-name;
                ping-result: root.ping-result;
                state: root.state;
                status-text: root.status-text;
                speed-text: root.speed-text;
                needs-admin: root.needs-admin;
                mode-index <=> root.mode-index;
                toggle-connect => { root.toggle-connect(); }
                ping-selected => { root.ping-selected(); }
                mode-changed(v) => { root.mode-changed(v); }
                restart-as-admin => { root.restart-as-admin(); }
            }
        }
    }
    }

    if root.hwid-open : HwidDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        device-id: root.device-id;
        value <=> root.hwid-input;
        error <=> root.hwid-error;
        save(v) => { root.hwid-save(v); }
        reset => { root.hwid-reset(); }
        cancel => { root.hwid-open = false; }
    }
}
