// Page "Настройки". OWNER: T17B.
// Rust side: src/pages/settings.rs talks to the page ONLY through the global SettingsBridge.
import { ScrollView, LineEdit, TextEdit, Switch, ComboBox, SpinBox, Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsCard, SettingsRow, SettingsField } from "settings-card.slint";

export global SettingsBridge {
    // --- Подключение -------------------------------------------------------
    in-out property <bool> tun-mode: false;
    in-out property <int> socks-port: 10808;
    in-out property <int> http-port: 10809;
    in-out property <bool> allow-lan: false;
    in-out property <bool> set-system-proxy: true;
    in-out property <string> bypass: "";
    in-out property <bool> mux: false;
    in-out property <string> fingerprint: "chrome";

    // --- TUN ---------------------------------------------------------------
    in-out property <string> tun-stack: "mixed";
    in-out property <int> tun-mtu: 9000;
    in-out property <bool> tun-ipv6: false;

    // --- DNS ---------------------------------------------------------------
    in-out property <string> dns-remote: "";
    in-out property <string> dns-direct: "";
    in-out property <bool> dns-fake-ip: false;

    // --- Пинг --------------------------------------------------------------
    in-out property <string> ping-method: "url";
    in-out property <string> ping-url: "";

    // --- Приложение --------------------------------------------------------
    in-out property <bool> launch-at-login: false;
    in-out property <bool> connect-on-launch: false;
    in-out property <bool> minimize-to-tray: true;
    in-out property <bool> auto-update: true;
    in-out property <int> theme-index: 0;   // 0 system, 1 dark, 2 light
    in-out property <int> language-index: 0; // 0 ru, 1 en
    in-out property <string> log-level: "warning";

    // --- Состояние ---------------------------------------------------------
    in property <string> ports-error: "";
    in property <string> dns-error: "";
    in property <string> ping-error: "";
    in property <string> save-status: "";
    in-out property <bool> reset-confirm: false;

    callback changed();
    callback mode-changed(bool);
    callback reset-confirmed();
    callback reset-cancelled();
}

export component SettingsPage inherits Rectangle {
    background: Theme.panel-bg;
    border-radius: 16px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Title row.
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Text {
                text: "Настройки";
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: SettingsBridge.save-status;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            Button {
                text: "Сбросить";
                clicked => { SettingsBridge.reset-confirm = true; }
            }
        }

        // Reset confirmation row.
        if SettingsBridge.reset-confirm : Rectangle {
            height: 40px;
            border-radius: 8px;
            background: Theme.control-bg;
            border-width: 1px;
            border-color: Theme.stroke;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                alignment: center;
                Text {
                    text: "Сбросить все настройки к значениям по умолчанию?";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    text: "Да";
                    clicked => { SettingsBridge.reset-confirmed(); }
                }
                Button {
                    text: "Отмена";
                    clicked => { SettingsBridge.reset-confirm = false; SettingsBridge.reset-cancelled(); }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 12px;

                // ---------------- Подключение ----------------
                SettingsCard {
                    title: "Подключение";

                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;
                        Text {
                            text: "Режим";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 160px;
                            height: 32px;
                            border-radius: 8px;
                            background: Theme.track;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    background: !SettingsBridge.tun-mode ? Theme.accent : transparent;
                                    Text {
                                        text: "Proxy";
                                        color: !SettingsBridge.tun-mode ? Theme.on-accent : Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (SettingsBridge.tun-mode) {
                                                SettingsBridge.tun-mode = false;
                                                SettingsBridge.mode-changed(false);
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    background: SettingsBridge.tun-mode ? Theme.accent : transparent;
                                    Text {
                                        text: "TUN";
                                        color: SettingsBridge.tun-mode ? Theme.on-accent : Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (!SettingsBridge.tun-mode) {
                                                SettingsBridge.tun-mode = true;
                                                SettingsBridge.mode-changed(true);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    SettingsRow {
                        label: "SOCKS-порт";
                        hint: "локальный mixed-вход";
                        SpinBox {
                            width: 130px;
                            minimum: 1024;
                            maximum: 65535;
                            value <=> SettingsBridge.socks-port;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "HTTP-порт";
                        SpinBox {
                            width: 130px;
                            minimum: 1024;
                            maximum: 65535;
                            value <=> SettingsBridge.http-port;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    if SettingsBridge.ports-error != "" : Text {
                        text: SettingsBridge.ports-error;
                        color: Theme.danger;
                        font-size: 11px;
                    }

                    SettingsRow {
                        label: "Разрешить доступ из локальной сети";
                        hint: "слушать 0.0.0.0 вместо 127.0.0.1";
                        Switch {
                            checked <=> SettingsBridge.allow-lan;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Устанавливать системный прокси";
                        Switch {
                            checked <=> SettingsBridge.set-system-proxy;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Mux (мультиплексирование)";
                        hint: "недоступно для потоков xtls";
                        Switch {
                            checked <=> SettingsBridge.mux;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Отпечаток (fingerprint)";
                        ComboBox {
                            width: 160px;
                            model: ["chrome", "firefox", "safari", "edge", "random", "ios", "android"];
                            current-value <=> SettingsBridge.fingerprint;
                            selected => { SettingsBridge.changed(); }
                        }
                    }

                    SettingsField {
                        label: "Список исключений (по одному в строке)";
                        TextEdit {
                            height: 84px;
                            text <=> SettingsBridge.bypass;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ---------------- TUN ----------------
                SettingsCard {
                    title: "TUN";

                    SettingsRow {
                        label: "Стек";
                        ComboBox {
                            width: 160px;
                            model: ["system", "gvisor", "mixed"];
                            current-value <=> SettingsBridge.tun-stack;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "MTU";
                        SpinBox {
                            width: 130px;
                            minimum: 576;
                            maximum: 65535;
                            value <=> SettingsBridge.tun-mtu;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Поддержка IPv6";
                        Switch {
                            checked <=> SettingsBridge.tun-ipv6;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ---------------- DNS ----------------
                SettingsCard {
                    title: "DNS";

                    SettingsField {
                        label: "Удалённый DNS (для проксируемых запросов)";
                        LineEdit {
                            text <=> SettingsBridge.dns-remote;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsField {
                        label: "Прямой DNS (для напрямую)";
                        LineEdit {
                            text <=> SettingsBridge.dns-direct;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    if SettingsBridge.dns-error != "" : Text {
                        text: SettingsBridge.dns-error;
                        color: Theme.danger;
                        font-size: 11px;
                    }
                    SettingsRow {
                        label: "Fake-IP";
                        hint: "в режиме TUN";
                        Switch {
                            checked <=> SettingsBridge.dns-fake-ip;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ---------------- Пинг ----------------
                SettingsCard {
                    title: "Пинг";

                    SettingsRow {
                        label: "Метод";
                        ComboBox {
                            width: 160px;
                            model: ["tcp", "url"];
                            current-value <=> SettingsBridge.ping-method;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsField {
                        label: "URL для проверки";
                        LineEdit {
                            text <=> SettingsBridge.ping-url;
                            edited => { SettingsBridge.changed(); }
                        }
                        error: SettingsBridge.ping-error;
                    }
                }

                // ---------------- Приложение ----------------
                SettingsCard {
                    title: "Приложение";

                    SettingsRow {
                        label: "Запускать при входе в систему";
                        Switch {
                            checked <=> SettingsBridge.launch-at-login;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Подключаться при запуске";
                        Switch {
                            checked <=> SettingsBridge.connect-on-launch;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Сворачивать в трей";
                        Switch {
                            checked <=> SettingsBridge.minimize-to-tray;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Автообновление подписок";
                        Switch {
                            checked <=> SettingsBridge.auto-update;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Тема";
                        ComboBox {
                            width: 160px;
                            model: ["Системная", "Тёмная", "Светлая"];
                            current-index <=> SettingsBridge.theme-index;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Язык";
                        ComboBox {
                            width: 160px;
                            model: ["Русский", "English"];
                            current-index <=> SettingsBridge.language-index;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Уровень логирования";
                        ComboBox {
                            width: 160px;
                            model: ["error", "warning", "info", "debug"];
                            current-value <=> SettingsBridge.log-level;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                }

                Rectangle { height: 4px; background: transparent; }
            }
        }
    }
}
