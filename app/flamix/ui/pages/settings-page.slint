// Page "Настройки". OWNER: T24.
// Rust side: src/pages/settings.rs talks to the page ONLY through the global SettingsBridge.
// Two tiers: Основные (always visible) and a collapsible Дополнительно group.
import { ScrollView, LineEdit, TextEdit, Switch, CheckBox, ComboBox, SpinBox, Button } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { SettingsCard, SettingsRow, SettingsField } from "settings-card.slint";
import { Segmented } from "../components/segmented.slint";

export global SettingsBridge {
    // --- Основные · Подключение ------------------------------------------
    in-out property <bool> tun-mode: false;
    in-out property <int> socks-port: 10808;
    in-out property <int> http-port: 10809;
    in-out property <bool> allow-lan: false;
    in-out property <bool> set-system-proxy: true;
    in-out property <bool> udp-enabled: true;
    in-out property <bool> sniffing: true;

    // --- Основные · TUN ---------------------------------------------------
    in-out property <string> tun-stack: "mixed";
    in-out property <int> tun-mtu: 9000;
    in-out property <bool> tun-ipv6: false;
    in-out property <bool> tun-auto-route: true;
    in-out property <bool> tun-strict-route: false;

    // --- Основные · DNS ---------------------------------------------------
    in-out property <string> dns-remote: "";
    in-out property <string> dns-direct: "";
    in-out property <bool> dns-fake-ip: false;

    // --- Основные · Геоданные --------------------------------------------
    in-out property <int> geo-source-index: 0; // 0 Freedom for Russia, 1 Loyalsoldier, 2 Свой URL
    in-out property <string> geo-geosite-url: "";
    in-out property <string> geo-geoip-url: "";
    in property <string> geo-updated-text: "никогда";
    in property <string> geo-urls-error: "";

    // --- Основные · Пинг --------------------------------------------------
    in-out property <string> ping-method: "url";
    in-out property <string> ping-url: "";

    // --- Основные · Приложение -------------------------------------------
    in-out property <bool> launch-at-login: false;
    in-out property <bool> connect-on-launch: false;
    in-out property <bool> minimize-to-tray: true;
    in-out property <bool> auto-update: true;
    in-out property <int> theme-index: 0;   // 0 system, 1 dark, 2 light
    in-out property <int> language-index: 0; // 0 ru, 1 en
    in-out property <string> log-level: "warning";

    // --- Дополнительно ----------------------------------------------------
    in-out property <bool> advanced-open: false;
    in-out property <bool> dest-http: true;
    in-out property <bool> dest-tls: true;
    in-out property <bool> dest-quic: false;
    in-out property <bool> dest-fakedns: false;
    in-out property <bool> route-only: false;
    in-out property <string> local-auth-user: "";
    in-out property <string> local-auth-pass: "";
    in-out property <string> tun-icmp: "reply";
    in-out property <string> route-exclude: "";
    in-out property <string> dns-fake-ip-range: "198.18.0.0/15";
    in-out property <string> dns-bootstrap: "";
    in-out property <bool> dns-block-svcb: false;
    in-out property <bool> dns-parallel: true;
    in-out property <bool> dns-serve-stale: false;
    in-out property <string> dns-hosts: "";
    in-out property <bool> mux: false;
    in-out property <int> mux-concurrency: 8;
    in-out property <string> core-override: "auto";
    in-out property <string> fingerprint: "chrome";
    in-out property <string> bypass: "";

    // --- Состояние --------------------------------------------------------
    in property <string> ports-error: "";
    in property <string> dns-error: "";
    in property <string> ping-error: "";
    in property <string> route-exclude-error: "";
    in property <string> save-status: "";
    in-out property <bool> reset-confirm: false;

    callback changed();
    callback mode-changed(bool);
    callback update-geo();
    callback reset-confirmed();
    callback reset-cancelled();
}

export component SettingsPage inherits Rectangle {
    background: Theme.panel-bg;
    border-radius: 16px;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // Title row.
        HorizontalLayout {
            height: 34px;
            spacing: 10px;
            Text {
                text: "Настройки";
                color: Theme.text;
                font-size: 20px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            Text {
                text: SettingsBridge.save-status;
                color: Theme.muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            Button {
                text: "Сбросить";
                clicked => { SettingsBridge.reset-confirm = true; }
            }
        }

        // Reset confirmation row.
        if SettingsBridge.reset-confirm : Rectangle {
            height: 40px;
            border-radius: 8px;
            background: Theme.control-bg;
            border-width: 1px;
            border-color: Theme.stroke;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                cross-axis-alignment: center;
                Text {
                    text: "Сбросить все настройки к значениям по умолчанию?";
                    color: Theme.text;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    text: "Да";
                    clicked => { SettingsBridge.reset-confirmed(); }
                }
                Button {
                    text: "Отмена";
                    clicked => { SettingsBridge.reset-confirm = false; SettingsBridge.reset-cancelled(); }
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            content-width: self.visible-width;
            VerticalLayout {
                spacing: 12px;

                // ==================== ОСНОВНЫЕ ====================

                // ---------------- Подключение ----------------
                SettingsCard {
                    title: "Подключение";

                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;
                        Text {
                            text: "Режим";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Rectangle {
                            width: 160px;
                            height: 32px;
                            border-radius: 8px;
                            background: Theme.track;
                            HorizontalLayout {
                                padding: 3px;
                                spacing: 3px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    background: !SettingsBridge.tun-mode ? Theme.accent : transparent;
                                    Text {
                                        text: "Proxy";
                                        color: !SettingsBridge.tun-mode ? Theme.on-accent : Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (SettingsBridge.tun-mode) {
                                                SettingsBridge.tun-mode = false;
                                                SettingsBridge.mode-changed(false);
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 6px;
                                    background: SettingsBridge.tun-mode ? Theme.accent : transparent;
                                    Text {
                                        text: "TUN";
                                        color: SettingsBridge.tun-mode ? Theme.on-accent : Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (!SettingsBridge.tun-mode) {
                                                SettingsBridge.tun-mode = true;
                                                SettingsBridge.mode-changed(true);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    SettingsField {
                        label: "Ядро";
                        hint: "Авто выбирает ядро по протоколу сервера";
                        Segmented {
                            options: ["Авто", "Xray", "sing-box", "mihomo"];
                            current: SettingsBridge.core-override == "xray" ? 1
                                : SettingsBridge.core-override == "sing-box" ? 2
                                : SettingsBridge.core-override == "mihomo" ? 3 : 0;
                            selected(i) => {
                                SettingsBridge.core-override = ["auto", "xray", "sing-box", "mihomo"][i];
                                SettingsBridge.changed();
                            }
                        }
                    }
                    SettingsRow {
                        label: "SOCKS-порт";
                        hint: "локальный mixed-вход";
                        SpinBox {
                            width: 130px;
                            minimum: 1024;
                            maximum: 65535;
                            value <=> SettingsBridge.socks-port;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "HTTP-порт";
                        SpinBox {
                            width: 130px;
                            minimum: 1024;
                            maximum: 65535;
                            value <=> SettingsBridge.http-port;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    if SettingsBridge.ports-error != "" : Text {
                        text: SettingsBridge.ports-error;
                        color: Theme.danger;
                        font-size: 11px;
                    }
                    SettingsRow {
                        label: "Разрешить доступ из локальной сети";
                        hint: "слушать 0.0.0.0 вместо 127.0.0.1";
                        Switch {
                            checked <=> SettingsBridge.allow-lan;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Устанавливать системный прокси";
                        Switch {
                            checked <=> SettingsBridge.set-system-proxy;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "UDP";
                        hint: "UDP на локальном SOCKS/HTTP-входе";
                        Switch {
                            checked <=> SettingsBridge.udp-enabled;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Снифинг";
                        hint: "определять домен из трафика";
                        Switch {
                            checked <=> SettingsBridge.sniffing;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ---------------- TUN ----------------
                SettingsCard {
                    title: "TUN";

                    SettingsRow {
                        label: "Стек";
                        ComboBox {
                            width: 160px;
                            model: ["system", "gvisor", "mixed"];
                            current-value <=> SettingsBridge.tun-stack;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "MTU";
                        SpinBox {
                            width: 130px;
                            minimum: 576;
                            maximum: 65535;
                            value <=> SettingsBridge.tun-mtu;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Поддержка IPv6";
                        Switch {
                            checked <=> SettingsBridge.tun-ipv6;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Автоматическая маршрутизация";
                        Switch {
                            checked <=> SettingsBridge.tun-auto-route;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Строгая маршрутизация";
                        hint: "не откатываться к маршруту по умолчанию";
                        Switch {
                            checked <=> SettingsBridge.tun-strict-route;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ---------------- DNS ----------------
                SettingsCard {
                    title: "DNS";

                    SettingsField {
                        label: "Удалённый DNS (для проксируемых запросов)";
                        LineEdit {
                            text <=> SettingsBridge.dns-remote;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsField {
                        label: "Прямой DNS (для напрямую)";
                        LineEdit {
                            text <=> SettingsBridge.dns-direct;
                            edited => { SettingsBridge.changed(); }
                        }
                    }
                    if SettingsBridge.dns-error != "" : Text {
                        text: SettingsBridge.dns-error;
                        color: Theme.danger;
                        font-size: 11px;
                    }
                    SettingsRow {
                        label: "Fake-IP";
                        hint: "в режиме TUN";
                        Switch {
                            checked <=> SettingsBridge.dns-fake-ip;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ---------------- Геоданные ----------------
                SettingsCard {
                    title: "Геоданные";

                    SettingsRow {
                        label: "Источник";
                        hint: "какие списки RU/geo используют ядра";
                        ComboBox {
                            width: 200px;
                            model: ["Freedom for Russia", "Loyalsoldier", "Свой URL"];
                            current-index <=> SettingsBridge.geo-source-index;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    if SettingsBridge.geo-source-index == 2 : VerticalLayout {
                        spacing: 10px;
                        SettingsField {
                            label: "geosite.dat URL";
                            LineEdit {
                                text <=> SettingsBridge.geo-geosite-url;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "geoip.dat URL";
                            LineEdit {
                                text <=> SettingsBridge.geo-geoip-url;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        if SettingsBridge.geo-urls-error != "" : Text {
                            text: SettingsBridge.geo-urls-error;
                            color: Theme.danger;
                            font-size: 11px;
                        }
                    }
                    Text {
                        text: "Источник определяет, какие базы RU/geo-правил скачивают ядра. По умолчанию — Freedom for Russia.";
                        color: Theme.muted;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Button {
                            text: "Обновить геоданные";
                            clicked => { SettingsBridge.update-geo(); }
                        }
                        Text {
                            text: "Обновлено: " + SettingsBridge.geo-updated-text;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                    }
                }

                // ---------------- Пинг ----------------
                SettingsCard {
                    title: "Пинг";

                    SettingsRow {
                        label: "Метод";
                        ComboBox {
                            width: 160px;
                            model: ["tcp", "url"];
                            current-value <=> SettingsBridge.ping-method;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsField {
                        label: "URL для проверки";
                        LineEdit {
                            text <=> SettingsBridge.ping-url;
                            edited => { SettingsBridge.changed(); }
                        }
                        error: SettingsBridge.ping-error;
                    }
                }

                // ---------------- Приложение ----------------
                SettingsCard {
                    title: "Приложение";

                    SettingsRow {
                        label: "Запускать при входе в систему";
                        Switch {
                            checked <=> SettingsBridge.launch-at-login;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Подключаться при запуске";
                        Switch {
                            checked <=> SettingsBridge.connect-on-launch;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Сворачивать в трей";
                        Switch {
                            checked <=> SettingsBridge.minimize-to-tray;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Автообновление подписок";
                        Switch {
                            checked <=> SettingsBridge.auto-update;
                            toggled => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Тема";
                        ComboBox {
                            width: 160px;
                            model: ["Системная", "Тёмная", "Светлая"];
                            current-index <=> SettingsBridge.theme-index;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Язык";
                        ComboBox {
                            width: 160px;
                            model: ["Русский", "English"];
                            current-index <=> SettingsBridge.language-index;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                    SettingsRow {
                        label: "Уровень логирования";
                        ComboBox {
                            width: 160px;
                            model: ["error", "warning", "info", "debug"];
                            current-value <=> SettingsBridge.log-level;
                            selected => { SettingsBridge.changed(); }
                        }
                    }
                }

                // ==================== ДОПОЛНИТЕЛЬНО ====================
                SettingsCard {
                    title: "Дополнительно";

                    HorizontalLayout {
                        spacing: 12px;
                        cross-axis-alignment: center;
                        Text {
                            text: "Показать дополнительные настройки";
                            color: Theme.text;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Switch {
                            checked <=> SettingsBridge.advanced-open;
                        }
                    }

                    if SettingsBridge.advanced-open : VerticalLayout {
                        spacing: 10px;

                        SettingsField {
                            label: "Снифинг destOverride";
                            hint: "какие протоколы определять";
                            HorizontalLayout {
                                spacing: 18px;
                                CheckBox {
                                    text: "http";
                                    checked <=> SettingsBridge.dest-http;
                                    toggled => { SettingsBridge.changed(); }
                                }
                                CheckBox {
                                    text: "tls";
                                    checked <=> SettingsBridge.dest-tls;
                                    toggled => { SettingsBridge.changed(); }
                                }
                                CheckBox {
                                    text: "quic";
                                    checked <=> SettingsBridge.dest-quic;
                                    toggled => { SettingsBridge.changed(); }
                                }
                                CheckBox {
                                    text: "fakedns";
                                    checked <=> SettingsBridge.dest-fakedns;
                                    toggled => { SettingsBridge.changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                            }
                        }
                        SettingsRow {
                            label: "Только для маршрутизации";
                            hint: "routeOnly: не подменять назначение";
                            Switch {
                                checked <=> SettingsBridge.route-only;
                                toggled => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "Логин локального входа";
                            LineEdit {
                                text <=> SettingsBridge.local-auth-user;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "Пароль локального входа";
                            hint: "провайдерские socks-auth/http-auth имеют приоритет";
                            LineEdit {
                                text <=> SettingsBridge.local-auth-pass;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsRow {
                            label: "Маршрутизация ICMP";
                            ComboBox {
                                width: 160px;
                                model: ["rule", "direct", "unreachable", "drop", "reply"];
                                current-value <=> SettingsBridge.tun-icmp;
                                selected => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "Исключения из auto-route (CIDR, по одному в строке)";
                            TextEdit {
                                height: 72px;
                                text <=> SettingsBridge.route-exclude;
                                edited => { SettingsBridge.changed(); }
                            }
                            error: SettingsBridge.route-exclude-error;
                        }

                        Rectangle { height: 1px; background: Theme.stroke; }

                        SettingsField {
                            label: "Диапазон Fake-IP";
                            LineEdit {
                                text <=> SettingsBridge.dns-fake-ip-range;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "Bootstrap DNS";
                            hint: "резолвер для адресов DNS-серверов (sing-box)";
                            LineEdit {
                                text <=> SettingsBridge.dns-bootstrap;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsRow {
                            label: "Блокировать SVCB/HTTPS";
                            hint: "sing-box, чтобы браузеры использовали A/AAAA";
                            Switch {
                                checked <=> SettingsBridge.dns-block-svcb;
                                toggled => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsRow {
                            label: "Параллельные DNS-запросы";
                            hint: "Xray";
                            Switch {
                                checked <=> SettingsBridge.dns-parallel;
                                toggled => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsRow {
                            label: "Отдавать устаревшие ответы";
                            hint: "Xray serveStale";
                            Switch {
                                checked <=> SettingsBridge.dns-serve-stale;
                                toggled => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "Hosts (domain ip, по одному в строке)";
                            TextEdit {
                                height: 72px;
                                text <=> SettingsBridge.dns-hosts;
                                edited => { SettingsBridge.changed(); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.stroke; }

                        SettingsRow {
                            label: "Mux (мультиплексирование)";
                            hint: "недоступно для потоков xtls";
                            Switch {
                                checked <=> SettingsBridge.mux;
                                toggled => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsRow {
                            label: "Mux concurrency";
                            SpinBox {
                                width: 130px;
                                minimum: 1;
                                maximum: 1024;
                                value <=> SettingsBridge.mux-concurrency;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsRow {
                            label: "Отпечаток (fingerprint)";
                            ComboBox {
                                width: 160px;
                                model: ["chrome", "firefox", "safari", "edge", "random", "ios", "android"];
                                current-value <=> SettingsBridge.fingerprint;
                                selected => { SettingsBridge.changed(); }
                            }
                        }
                        SettingsField {
                            label: "Список исключений системного прокси (по одному в строке)";
                            TextEdit {
                                height: 72px;
                                text <=> SettingsBridge.bypass;
                                edited => { SettingsBridge.changed(); }
                            }
                        }
                    }
                }

                Rectangle { height: 4px; background: transparent; }
            }
        }
    }
}
